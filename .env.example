# ---------------------------------------------------------------------------
# Doctor Tracker — frontend environment variables
#
# Copy this file to `.env.local` and adjust the values for your machine.
# Every variable below is consumed by the Next.js build, so changes require a
# restart of `npm run dev` (or a new deployment) to take effect.
#
# `.env.local` is git-ignored — never commit real values. Commit only this
# `.env.example` template.
# ---------------------------------------------------------------------------

# Base URL of the REST API (no trailing slash).
# This is the ONLY source for the API base URL — there is no hardcoded fallback,
# so the app will fail fast if it is missing. The API may live on a different
# domain than this frontend; requests are sent with `withCredentials: true` so
# the httpOnly session cookie travels with them.
#   local:      http://localhost:5000/api
#   production: https://api.your-domain.com/api
NEXT_PUBLIC_API_URL=

# Public origin of THIS Next.js site (no trailing slash).
# Used to build absolute URLs for OpenGraph/Twitter metadata and the canonical
# link tag. On Vercel this can be left unset — the build falls back to
# `VERCEL_URL` automatically.
#   local:      http://localhost:3000
#   production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=

# Name of the *session hint* cookie the frontend sets for itself.
#
# The authoritative session lives in the API's httpOnly cookie (`dt_token`),
# which JavaScript can never read. Because that cookie is scoped to the API
# origin, the Next.js middleware cannot see it — so the frontend keeps its own
# tiny, readable marker cookie that only says "a session may exist".
#
# It carries NO session material. The real gate stays the API's auth middleware
# plus the client-side `AuthGuard`. Change the value only if it clashes with
# another application on the same domain.
NEXT_PUBLIC_AUTH_COOKIE=dt_session

# Demo mode switch.
#
# MUST be the exact string `true` to enable anything. Every other value (or
# leaving the variable unset) evaluates to false, so a production build can
# never switch demo behaviour on by accident — there is no truthy-string
# shortcut such as `1` or `yes`.
#
# When demo mode is on, the login screen shows the seeded demo credentials. The
# flag is inlined at build time by Next.js, so in any build where it is not set
# the demo branches are stripped from the bundle by dead-code elimination.
#   enabled:  true
#   disabled: (unset) or false
NEXT_PUBLIC_DEMO_MODE=false
